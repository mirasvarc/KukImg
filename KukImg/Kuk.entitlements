<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sparkle: download updates; Photos: fetch iCloud-only originals -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Browse albums from the system Photos library -->
	<key>com.apple.security.personal-information.photos-library</key>
	<true/>
	<!-- Security-scoped bookmarks for Recents / reopening the last folder -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<!-- Sparkle: talk to its installer/status XPC services from the sandbox -->
	<key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
	<array>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)-spks</string>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)-spki</string>
	</array>
</dict>
</plist>
